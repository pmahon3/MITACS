# macOS Finder metadata (some were tracked before this rule; untracked
# in the same commit that added this line)
.DS_Store

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Generated estimator artifacts (regenerable via run_pipeline.py;
# profile-dependent binary tensors, not meaningful to version)
processing/innovations/outputs/

# Raw IESO forecast XML cache (bulky, regenerable by data.forecast_scraping;
# the parsed data product data/ontario/forecast/ieso_forecast.csv IS tracked,
# matching the repo convention of tracking processed demand CSVs)
data/ontario/forecast/xml/
# Raw IESO day-ahead totals XML cache (regenerable by data.da_forecast_scraping;
# same convention as the xml/ cache above)
data/ontario/forecast/da_xml/

# Legacy climate data (paths no longer in this layout)
src/main/resources/data/climate/ontario/*
src/main/resources/data/ontario/climate/ontario/csv_files/54239.csv

# Local convenience archives (originals recoverable from git history)
archive/

# IDE / editor and Claude Code local state (machine-specific, not project)
.idea/
.claude/

# Third-party competition data: IEEE DataPort Post-COVID load-forecasting
# dataset (re-hosting governed by IEEE DataPort terms). The probe scripts
# scratch/postcovid_*.py ARE tracked; the CSVs are reproducible from the
# primary source per scratch/data/postcovid/README.md.
scratch/data/postcovid/*.csv

# Experiment ledger: gitignored UNTIL a live collect run produces genuine
# accrued forecasts/actuals. Current/offline-test contents are regenerable
# placeholder rows, NOT the experiment record. Track it (remove this rule)
# once real data accrues -- it is then irreplaceable like settled_actuals.csv.
data/ontario/forecast/experiment_ledger.csv

# LaTeX build artifacts (generated from the .tex source; do not track).
# Patterns match writeup/ AND writeup/tex/ (the canonical .tex home as of
# 2026-05-19; the legacy writeup/*.aux patterns are kept because that
# location may still see ad-hoc builds).
writeup/*.aux
writeup/*.fdb_latexmk
writeup/*.fls
writeup/*.log
writeup/*.out
writeup/*.pdf
writeup/*.synctex.gz
writeup/tex/*.aux
writeup/tex/*.fdb_latexmk
writeup/tex/*.fls
writeup/tex/*.log
writeup/tex/*.out
writeup/tex/*.pdf
writeup/tex/*.synctex.gz
writeup/tex/*.bbl
writeup/tex/*.blg
writeup/tex/*.toc
