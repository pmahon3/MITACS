# macOS Finder metadata (some were tracked before this rule; untracked
# in the same commit that added this line)
.DS_Store

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# Generated estimator artifacts (regenerable via run_pipeline.py;
# profile-dependent binary tensors, not meaningful to version)
processing/innovations/outputs/

# Raw IESO forecast XML cache (bulky, regenerable by data.forecast_scraping;
# the parsed data product data/ontario/forecast/ieso_forecast.csv IS tracked,
# matching the repo convention of tracking processed demand CSVs)
data/ontario/forecast/xml/

# Legacy climate data (paths no longer in this layout)
src/main/resources/data/climate/ontario/*
src/main/resources/data/ontario/climate/ontario/csv_files/54239.csv

# Local convenience archives (originals recoverable from git history)
archive/

# Experiment ledger: gitignored UNTIL a live collect run produces genuine
# accrued forecasts/actuals. Current/offline-test contents are regenerable
# placeholder rows, NOT the experiment record. Track it (remove this rule)
# once real data accrues -- it is then irreplaceable like settled_actuals.csv.
data/ontario/forecast/experiment_ledger.csv
